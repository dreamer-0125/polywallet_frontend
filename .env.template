# Optional: full API root including /api, e.g. https://api.example.com/api
# Leave unset during local dev to use Vite proxy (same-origin, no CORS).
# VITE_BACKEND_URL=

# Optional: where Vite proxies /api in dev (default http://127.0.0.1:8080)
# VITE_PROXY_TARGET=http://127.0.0.1:8080

# Polygon USDC deposit recipient (0x address PolyWallet treasury)
# VITE_POLYWALLET_USDC_RECIPIENT=0xYourTreasuryAddress

# WalletConnect Cloud project id (register at https://cloud.walletconnect.com)
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id

# Never use VITE_* for private keys or API secrets — Vite exposes those to the client bundle.
